# Copy to .env ON THE SERVER, with chmod 600. Never send secrets in chat or Git.
SITE_HOST=your-real-domain.example
# Leave empty for a restored existing database. Only a fresh empty database uses this hash.
ADMIN_REGISTRATION_HASH=
# Optional pre-existing HTTPS WebDAV backup directory and a separate app password:
BACKUP_WEBDAV_URL=
BACKUP_WEBDAV_USERNAME=
BACKUP_WEBDAV_PASSWORD=
